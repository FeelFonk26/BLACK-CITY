# Location snippets for the EXISTING HTTPS server block for blackcytigame.duckdns.org.
# Do NOT enable this as a separate server block: the current site already owns ports 80/443.
# Insert these locations inside the existing TLS server block, before its "location /" block.
# Existing /pay/ and /yoomoney/notify locations must remain unchanged.

location = /health {
    proxy_pass http://127.0.0.1:4000/health;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /api/ {
    proxy_pass http://127.0.0.1:4000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
